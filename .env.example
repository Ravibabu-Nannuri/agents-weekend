# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).

# ---- Model provider: "anthropic" (Claude) or "openai" ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional model overrides (defaults: claude-sonnet-5-5 / claude-haiku-5-5)
# MODEL=claude-sonnet-5-5
# CHEAP_MODEL=claude-haiku-5-5

# ---- Langfuse (https://cloud.langfuse.com -> project -> Settings -> API keys) ----
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# US region: https://us.cloud.langfuse.com    Self-hosted: http://localhost:3000
